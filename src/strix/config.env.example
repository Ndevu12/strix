# Environment contract for the strix summary renderer (src/strix)
#
# This is the single, documented interface between the action's steps (the producer) and the
# renderer (the consumer). In CI these variables are set by action.yml's step `env:` blocks and by
# the GitHub Actions runtime; the renderer reads them ONLY through strix.config.Config.from_env.
# Copy this file to `.env` and `set -a; . src/strix/.env; set +a`, then run
# `PYTHONPATH=src python3 -m strix` to drive the renderer locally against a real report.
#
# The variable NAMES here are mirrored one-to-one by the `_ENV` map in src/strix/config.py — keep
# the two in sync when adding a field.

# ── Report data (written by the "Run worm scan" step) ──────────────────────────────────────
# Preferred data source: the scanner's REDACTED report (evidence fingerprinted, not raw).
STRIX_REDACTED=/tmp/strix-reports/latest.json
# Fallback only (older scanner without `-d`): the full-evidence report. Evidence is NEVER rendered.
STRIX_REPORT=/tmp/strix-reports/report.json
# Where the shareable markdown body is written; the sticky-PR-comment step re-posts this file.
STRIX_SUMMARY_OUT=/tmp/strix-reports/summary.md

# ── Verdict & counts (the scan step's outputs) ─────────────────────────────────────────────
STRIX_VERDICT=infected      # clean | suspicious | infected | (empty on an aborted scan)
STRIX_INFECTED=1
STRIX_SUSPICIOUS=0
STRIX_FINDINGS=2
STRIX_SCAN_RC=1             # saw scan exit code: 0 clean, 1 infected, 2 usage/aborted

# ── Guidance context ───────────────────────────────────────────────────────────────────────
STRIX_CONFIG_INPUT=config/security.yml   # the workflow's config-file input (shown in the repro command)
STRIX_PATCHES=false                       # "true" when saw fix wrote sab-patches/*.patch

# ── Provided by the GitHub Actions runtime (do not set by hand in CI) ──────────────────────
# GITHUB_STEP_SUMMARY=/path/to/step-summary.md   # the run-page summary the renderer appends to
